{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autorefactor.ai/schemas/alpha_spec.json",
  "title": "AlphaSpec",
  "type": "object",
  "required": ["summary", "changes"],
  "properties": {
    "summary": { "type": "string" },
    "stop_reason": { "type": ["string", "null"] },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "rationale", "acceptance"],
        "properties": {
          "path": { "type": "string" },
          "rationale": { "type": "string" },
          "acceptance": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
