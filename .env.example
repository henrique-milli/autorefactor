# Shared fallback (optional). Prefer role-specific keys below.
CODERAZOR_API_KEY=
CODERAZOR_PROVIDER=openai
CODERAZOR_BASE_URL=https://api.openai.com/v1

# Analysis LLM
CODERAZOR_LLM_API_KEY=
CODERAZOR_LLM_BASE_URL=https://api.openai.com/v1
CODERAZOR_LLM_MODEL=gpt-4o-mini

# Embeddings
CODERAZOR_EMBED_API_KEY=
CODERAZOR_EMBED_BASE_URL=https://api.openai.com/v1
CODERAZOR_EMBED_MODEL=text-embedding-3-small

# Plugin behavior
CODERAZOR_DESCRIBE_MODE=index
CODERAZOR_CONFIDENCE_THRESHOLD=0.6

# Stages / analyzers
CODERAZOR_ANALYZERS=builtin,semgrep,ruff,eslint,java_static,coverage
# CODERAZOR_SEMGREP_CONFIG=p/ci
CODERAZOR_COVERAGE_THRESHOLD=80
CODERAZOR_DOCUMENT_LANGUAGES=java,typescript,javascript,python,go
CODERAZOR_DESCRIBE_CONCURRENCY=8
CODERAZOR_MAX_RETRIES=8
CODERAZOR_EXCLUDE_REPOS=
CODERAZOR_SIMILARITY_THRESHOLD=0.78

# Prefer .coderazor.toml via `coderazor init` for workspace settings.
