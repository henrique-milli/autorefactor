# Optional overrides — not required for quickstart.
# Every Settings field has a matching AUTOREFACTOR_* env var.
# Quickstart: docker compose up -d --build → paste API key in Settings.

COMPOSE_PROJECT_NAME=autorefactor

# Axes (default unset = cloud http/http — needs API key)
# AUTOREFACTOR_CHAT_BACKEND=http    # agent | http | none
# AUTOREFACTOR_EMBED_BACKEND=http   # local | http | none
# AUTOREFACTOR_EMBED_DEVICE=cpu     # cpu | gpu
# AUTOREFACTOR_LOCAL_CHAT=false

# AUTOREFACTOR_API_KEY=
# AUTOREFACTOR_LLM_MODEL=gpt-5.6-luna
# AUTOREFACTOR_EMBED_MODEL=text-embedding-3-small
# AUTOREFACTOR_BASE_URL=https://api.openai.com/v1

AUTOREFACTOR_WORKSPACE=.
AUTOREFACTOR_DATA=./.autorefactor-data
AUTOREFACTOR_PROFILE=full

AUTOREFACTOR_MCP_TRANSPORT=streamable-http
AUTOREFACTOR_MCP_HOST=0.0.0.0
AUTOREFACTOR_MCP_PORT=8765
AUTOREFACTOR_MCP_MAX_BODY=536870912

# Local Ollama (when using --profile ollama)
AUTOREFACTOR_OLLAMA_BASE_URL=http://ollama:11434/v1
AUTOREFACTOR_LOCAL_LLM_MODEL=gemma4:e2b
AUTOREFACTOR_LOCAL_EMBED_MODEL=nomic-embed-text
AUTOREFACTOR_LOCAL_EMBED_GPU_MODEL=qwen3-embedding:0.6b

AUTOREFACTOR_DESCRIBE_MODE=raw
AUTOREFACTOR_CONFIDENCE_THRESHOLD=0.6
AUTOREFACTOR_SIMILARITY_THRESHOLD=0.78
AUTOREFACTOR_COVERAGE_THRESHOLD=80
